# Copy to server/.env for local use. On Render, set these in the service's Environment tab.

# Postgres connection string. Local Docker (see docker-compose.yml):
DATABASE_URL=postgres://skillsync:skillsync@localhost:5433/skillsync

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# The admin account. The password is hashed with bcrypt into the users table on startup.
ADMIN_EMAIL=admin@skillsync.local
ADMIN_PASSWORD=change-this-password

# Allowed website origins, comma separated (your Vercel address, no trailing slash).
CORS_ORIGIN=http://localhost:5173

# Only used by `npm run seed` (demo contractor logins). Optional.
SEED_CONTRACTOR_PASSWORD=Contractor123

# Only used by `npm test`. This database is WIPED by the tests. Never point it at real data.
TEST_DATABASE_URL=postgres://skillsync:skillsync@localhost:5433/skillsync_test

# PORT=4000
# DATABASE_SSL=true   # force SSL on/off. Default: on for *.render.com addresses.
